# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# AI: used for message generation and location expansion (at least one recommended)
OPENAI_API_KEY=
GEMINI_API_KEY=

# Lead sources (optional; Google Maps falls back to a Puppeteer scraper without a Places key)
GOOGLE_PLACES_API_KEY=
YOUTUBE_API_KEY=

# Automation (optional): n8n webhook fired on pipeline events
N8N_WEBHOOK_URL=
